{
  "realm": "wagering",
  "enabled": true,
  "sslRequired": "none",
  "registrationAllowed": false,
  "accessTokenLifespan": 300,
  "bruteForceProtected": false,
  "roles": {
    "realm": [
      {
        "name": "wagering-provider",
        "description": "Game provider: may submit and read its own wagering transactions"
      },
      {
        "name": "wagering-internal",
        "description": "Trusted internal service: wallet operations and cross-provider reads"
      }
    ]
  },
  "clients": [
    {
      "clientId": "provider-a",
      "name": "provider-a",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "clientAuthenticatorType": "client-secret",
      "secret": "provider-a-secret",
      "serviceAccountsEnabled": true,
      "standardFlowEnabled": false,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "fullScopeAllowed": true,
      "attributes": {},
      "protocolMappers": [
        {
          "name": "audience-wagering-api",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.custom.audience": "wagering-api",
            "id.token.claim": "false",
            "access.token.claim": "true"
          }
        },
        {
          "name": "provider-id",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-hardcoded-claim-mapper",
          "consentRequired": false,
          "config": {
            "claim.name": "provider_id",
            "claim.value": "provider-a",
            "jsonType.label": "String",
            "id.token.claim": "false",
            "access.token.claim": "true",
            "userinfo.token.claim": "false"
          }
        }
      ]
    },
    {
