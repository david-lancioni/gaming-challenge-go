# Local development values. Copy to .env (docker compose reads it automatically).
# None of these are real secrets.

# --- PostgreSQL --------------------------------------------------------------
POSTGRES_USER=wagering
POSTGRES_PASSWORD=wagering
POSTGRES_DB=wagering
# Used by processes running on the host (migrations, tests, `go run`).
DATABASE_URL=postgres://wagering:wagering@localhost:5432/wagering?sslmode=disable

# --- AWS SQS (LocalStack) ----------------------------------------------------
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
# Endpoint as seen from the host. Inside Compose the services use http://localstack:4566.
AWS_ENDPOINT_URL=http://localhost:4566
SQS_INPUT_QUEUE=wager-transactions.fifo
SQS_INPUT_DLQ=wager-transactions-dlq.fifo
SQS_EVENTS_QUEUE=wager-events.fifo
SQS_VISIBILITY_TIMEOUT=60s
SQS_MAX_RECEIVE_COUNT=5

# --- Keycloak / OIDC ---------------------------------------------------------
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin
# Expected `iss` claim: the public URL of the realm (what token requesters use).
OIDC_ISSUER=http://localhost:8080/realms/wagering
# Where the service fetches signing keys (Compose: http://keycloak:8080/...).
OIDC_JWKS_URL=http://localhost:8080/realms/wagering/protocol/openid-connect/certs
OIDC_AUDIENCE=wagering-api
OIDC_ROLE_PROVIDER=wagering-provider
OIDC_ROLE_INTERNAL=wagering-internal
OIDC_PROVIDER_CLAIM=provider_id

# --- Service -----------------------------------------------------------------
HTTP_ADDR=:8080
METRICS_ADDR=:9100
LOG_LEVEL=info
SHUTDOWN_TIMEOUT=25s
ENABLE_HTTP=true
ENABLE_CONSUMER=true
ENABLE_PUBLISHER=true
ENABLE_PENDING_WORKER=true
DB_MAX_CONNS=20
DB_LOCK_TIMEOUT=5s
DB_STATEMENT_TIMEOUT=15s

# Consumer
CONSUMER_CONCURRENCY=4
CONSUMER_BATCH_SIZE=5
CONSUMER_PROCESS_TIMEOUT=30s
CONSUMER_RETRY_BASE=2s
CONSUMER_RETRY_MAX=60s

# Outbox publisher
OUTBOX_BATCH_SIZE=20
OUTBOX_POLL_INTERVAL=500ms
OUTBOX_LEASE=30s
OUTBOX_BACKOFF_BASE=1s
OUTBOX_BACKOFF_MAX=5m

# Pending references (REFUND/ROLLBACK/WIN whose reference has not arrived)
PENDING_TTL=10m
PENDING_MAX_ATTEMPTS=10
PENDING_BACKOFF_BASE=1s
PENDING_BACKOFF_MAX=60s
PENDING_POLL_INTERVAL=1s
PENDING_LEASE=30s
PENDING_BATCH_SIZE=20

# --- Integration tests (host) ------------------------------------------------
TEST_ADMIN_DATABASE_URL=postgres://wagering:wagering@localhost:5432/postgres?sslmode=disable
TEST_KEYCLOAK_URL=http://localhost:8080
TEST_OIDC_ISSUER=http://localhost:8080/realms/wagering
TEST_AWS_ENDPOINT_URL=http://localhost:4566
